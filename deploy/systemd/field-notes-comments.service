[Unit]
Description=Field Notes discussion API
Documentation=file:///home/user/personal-site-concepts/server/README.md
After=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/field-notes-comments/comments.env
ExecStart=%h/.local/lib/field-notes-comments/commentsd serve
Restart=on-failure
RestartSec=3s
TimeoutStopSec=15s
UMask=0077

NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=default.target
